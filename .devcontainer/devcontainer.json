{
  "name": "AQAP – منصة الجودة والاعتماد",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/aqap",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "AQAP", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -r requirements.txt && bash scripts/dev_setup.sh",
  "postStartCommand": "bash scripts/dev_run.sh",
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
